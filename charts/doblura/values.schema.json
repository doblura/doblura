{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Doblura values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "watchNamespaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "webhook": {
      "type": "object",
      "description": "The admission webhook that enforces the environment quota.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxEnvironmentsPerCreator": {
          "type": "integer",
          "description": "Ephemeral environments one person may hold at once, across every customer and namespace.",
          "minimum": 1
        },
        "exemptUsers": {
          "type": "array",
          "description": "Identities the quota does not apply to. The operator's own ServiceAccount is always exempt.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "personas": {
      "type": "object",
      "description": "Per-role ClusterRoles to bind to your OIDC groups.",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create the persona ClusterRoles: viewer, support, qa, consultancy, platform."
        }
      }
    },
    "instanceProbe": {
      "type": "object",
      "description": "Image used by the OdooInstance probe Pod.",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Needs psql, sh, df and awk."
        }
      }
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "error"
      ]
    },
    "logFormat": {
      "type": "string",
      "enum": [
        "console",
        "json"
      ]
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectStoreImage": {
          "type": "string"
        },
        "httpImage": {
          "type": "string"
        },
        "gitImage": {
          "type": "string"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "console": {
      "type": "object",
      "description": "The web console. Off by default: it needs an identity provider or an accounts Secret, and one that installs with neither would serve the customer list to whoever reaches it.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientID": {
              "type": "string"
            },
            "redirectURL": {
              "type": "string"
            },
            "groupsClaim": {
              "type": "string"
            },
            "clientSecretSecret": {
              "type": "string"
            }
          }
        },
        "localAccounts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        },
        "sessionKeySecret": {
          "type": "string"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "tlsSecretName": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "clusterName": {
          "type": "string",
          "description": "What the cluster this console runs in is called on screen. Only shown when there is more than one."
        },
        "clustersSecret": {
          "type": "string",
          "description": "Secret holding one kubeconfig per OTHER cluster, one per key, in the release namespace. Each must authenticate as a ServiceAccount whose only permission in that cluster is impersonate. Empty means one cluster, and then nothing about the interface changes."
        }
      }
    }
  }
}
